# Local development: copy to .env.local and enter your own organizer credentials.
# Never commit .env.local or paste the password in chat.
APP_ORIGIN=http://localhost:5173
MATCHROOM_DATA_DIR=.data
MATCHROOM_OWNER_EMAIL=
MATCHROOM_OWNER_NAME=Max
MATCHROOM_OWNER_PASSWORD=

# Render production settings:
# APP_ORIGIN=https://YOUR-EXISTING-SERVICE.onrender.com
# MATCHROOM_DATA_DIR=/var/data/matchroom
# Attach a persistent disk at /var/data before starting the service.
# Set the organizer password (12+ characters) in Render's secret environment UI.
# The organizer is created once. Changing this env value does not reset an
# existing account password. No default password or public signup is provided.

# Optional Discord connection (disabled unless both values are set on the server).
# Register the redirect URI <APP_ORIGIN>/api/discord/callback in the Discord
# Developer Portal (OAuth2 > Redirects). Keep the client secret in Render's secret
# environment UI only; never commit it or paste it in chat.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional public invite shown to signed-in members, e.g. https://discord.gg/xxxx
UGS_DISCORD_INVITE_URL=
